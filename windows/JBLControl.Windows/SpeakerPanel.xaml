<?xml version="1.0" encoding="utf-8"?>
<!--
    The speaker's controls, a port of Sources/JBLControl/Views/PanelView.swift (searching state, speaker
    switcher, header, preset picker, custom equalizer). Shared by the tray flyout and the main window,
    so both always show the same thing; each host adds its own footer.
-->
<UserControl
    x:Class="JBLControl.Windows.SpeakerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JBLControl.Windows">

    <StackPanel x:Name="Panel" Spacing="14">

        <!-- SearchingView.swift: compact, with no details of a previous speaker. -->
        <Border x:Name="SearchingCard" Style="{StaticResource CardStyle}" Padding="14,18">
            <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                <Grid Height="36" HorizontalAlignment="Center">
                    <FontIcon x:Name="SearchingIcon" Glyph="&#xE702;" FontSize="30" Foreground="{StaticResource JblAccentBrush}" />
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="SearchingTitle" Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="SearchingDetail" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="BluetoothSettingsButton" Content="Open Bluetooth Settings" HorizontalAlignment="Center"
                        FontSize="12" Visibility="Collapsed" Click="BluetoothSettings_Click" />
                <StackPanel x:Name="NearbyPanel" Spacing="6" Margin="0,2,0,0" Visibility="Collapsed">
                    <TextBlock Text="NEARBY" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NearbyChips" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- SpeakerSwitcher.swift: shown while connected when there's another speaker to switch to. -->
        <ScrollViewer x:Name="Switcher" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel x:Name="SwitcherChips" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />
        </ScrollViewer>

        <!-- HeaderView.swift -->
        <Grid x:Name="Header" ColumnSpacing="14" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtworkColumn" Width="104" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="Artwork" Width="104" Height="104" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="SubtitleText" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="SupportBadge" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock x:Name="SupportBadgeText" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                    <Border Style="{StaticResource PillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="7" Height="7" Fill="#FF34C759" VerticalAlignment="Center" />
                            <TextBlock Text="Connected" FontSize="12" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <!-- Battery (percentage inside the glyph) and, while Keep Awake is on, a cup that turns it off. -->
                    <Border x:Name="BatteryPill" Style="{StaticResource PillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <StackPanel x:Name="BatteryGlyph" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                <Grid Width="32" Height="15">
                                    <Border CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Border x:Name="BatteryFill" CornerRadius="2.5" Margin="1.5" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon x:Name="BatteryBolt" Glyph="&#xE945;" FontSize="7" />
                                        <TextBlock x:Name="BatteryText" FontSize="9.5" FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                                <Border Width="1.5" Height="5" CornerRadius="1" VerticalAlignment="Center"
                                        Background="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <Button x:Name="KeepAwakeCup" Padding="0" MinWidth="0" MinHeight="0" Background="Transparent"
                                    BorderThickness="0" Click="KeepAwakeCup_Click" Visibility="Collapsed"
                                    AutomationProperties.Name="Turn off Keep Awake">
                                <TextBlock x:Name="KeepAwakeCupText" Text="&#x2615;" FontFamily="Segoe UI Symbol" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- PresetPicker.swift: one toggle per preset, then Custom. Filled in from code. -->
        <Grid x:Name="PresetGrid" ColumnSpacing="6" Visibility="Collapsed" />

        <!-- EqualizerView.swift: only for Custom (or models without presets). -->
        <Border x:Name="EqualizerCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9E9;" FontSize="15" />
                        <TextBlock Text="Equalizer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <Button x:Name="ResetButton" HorizontalAlignment="Right" Padding="8,3" Click="Reset_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                            <TextBlock Text="Reset" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
                <local:EqualizerControl x:Name="Equalizer" />
                <Button x:Name="ExperimentalButton" HorizontalAlignment="Center" FontSize="12"
                        Visibility="Collapsed" Click="Experimental_Click"
                        ToolTipService.ToolTip="EQ changes on this model use JBL's protocol but haven't been tested on hardware yet." />
            </StackPanel>
        </Border>

        <!-- NoEQNotice -->
        <Border x:Name="NoEqCard" Style="{StaticResource CardStyle}" Padding="16" Visibility="Collapsed">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE9CE;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="NoEqText" Style="{StaticResource BodyStrongTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="Copy Diagnostics from the tray icon's menu and open an issue to help add support."
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
