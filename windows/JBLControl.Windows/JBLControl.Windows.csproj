<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WinUI 3 tray app (windows port plan section 5). Unpackaged and self-contained (the Windows
    App SDK runtime ships next to the exe), matching the Mac app's unsigned, unpackaged distribution —
    no MSIX, no separate runtime install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>JBLControl.Windows</RootNamespace>
    <AssemblyName>JBLControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- One version for both apps: read from the Mac app's Info.plist (Resources/Info.plist). -->
  <PropertyGroup>
    <InfoPlistPath>$(MSBuildThisFileDirectory)..\..\Resources\Info.plist</InfoPlistPath>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(InfoPlistPath)')), 'CFBundleShortVersionString&lt;/key&gt;\s*&lt;string&gt;([^&lt;]+)').Groups[1].Value)</Version>
    <BuildNumber>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(InfoPlistPath)')), 'CFBundleVersion&lt;/key&gt;\s*&lt;string&gt;([^&lt;]+)').Groups[1].Value)</BuildNumber>
    <FileVersion>$(Version).$(BuildNumber)</FileVersion>
    <Product>JBLControl</Product>
    <Description>JBL speaker control, right in your system tray.</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildNumber</_Parameter1>
      <_Parameter2>$(BuildNumber)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by scripts/make-windows-icons.ps1 from the Mac icon. -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JBLControlKit.Windows\JBLControlKit.Windows.csproj" />
  </ItemGroup>

</Project>
